
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class TypingSpeedTest extends JFrame {

    private final String paragraph =
        "Java is a popular programming language used to "
      + "develop desktop web and mobile applications.";

    private JTextArea inputArea;
    private JLabel resultLabel;
    private long startTime;
    private boolean started = false;

    public TypingSpeedTest() {
        setTitle("Typing Speed Test");
        setSize(600, 400);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        JLabel title = new JLabel(
            "TYPING SPEED TEST", JLabel.CENTER);
        title.setFont(new Font("Arial", Font.BOLD, 22));

        JTextArea sampleArea = new JTextArea(paragraph);
        sampleArea.setLineWrap(true);
        sampleArea.setWrapStyleWord(true);
        sampleArea.setEditable(false);
        sampleArea.setFont(new Font("Arial", Font.PLAIN, 16));

        inputArea = new JTextArea(5, 30);
        inputArea.setLineWrap(true);
        inputArea.setWrapStyleWord(true);
        inputArea.setFont(new Font("Arial", Font.PLAIN, 16));

        JButton finishButton = new JButton("Finish Test");
        JButton resetButton = new JButton("Reset");

        resultLabel = new JLabel(
            "Start typing the paragraph.", JLabel.CENTER);

        inputArea.addKeyListener(new KeyAdapter() {
            public void keyTyped(KeyEvent e) {
                if (!started) {
                    startTime = System.currentTimeMillis();
                    started = true;
                }
            }
        });

        finishButton.addActionListener(e -> calculateResult());
        resetButton.addActionListener(e -> resetTest());

        JPanel centerPanel = new JPanel(new GridLayout(2, 1, 5, 5));
        centerPanel.add(new JScrollPane(sampleArea));
        centerPanel.add(new JScrollPane(inputArea));

        JPanel bottomPanel = new JPanel();
        bottomPanel.add(finishButton);
        bottomPanel.add(resetButton);

        add(title, BorderLayout.NORTH);
        add(centerPanel, BorderLayout.CENTER);
        add(resultLabel, BorderLayout.SOUTH);
        add(bottomPanel, BorderLayout.PAGE_END);

        setVisible(true);
    }

    private void calculateResult() {
        if (!started) {
            resultLabel.setText("Please type something first.");
            return;
        }

        String typed = inputArea.getText().trim();

        if (typed.isEmpty()) {
            resultLabel.setText("Please type something first.");
            return;
        }

        long endTime = System.currentTimeMillis();
        double minutes = (endTime - startTime) / 60000.0;

        if (minutes <= 0) {
            minutes = 1.0 / 60.0;
        }

        int words = typed.split("\\s+").length;
        double wpm = words / minutes;

        int correct = 0;
        int limit = Math.min(typed.length(), paragraph.length());

        for (int i = 0; i < limit; i++) {
            if (typed.charAt(i) == paragraph.charAt(i)) {
                correct++;
            }
        }

        double accuracy =
            (correct * 100.0) / Math.max(typed.length(), 1);

        resultLabel.setText(String.format(
            "Speed: %.2f WPM | Accuracy: %.2f%%",
            wpm, accuracy));
    }

    private void resetTest() {
        inputArea.setText("");
        resultLabel.setText("Start typing the paragraph.");
        started = false;
        startTime = 0;
        inputArea.requestFocusInWindow();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(TypingSpeedTest::new);
    }
}
